# Secrets referenced by config/deploy.yml (registry/password and env/secret).
#
# Every value is resolved at DEPLOY TIME via shell indirection — no raw
# credential is ever written here, so this file is safe to commit. DO NOT paste
# resolved secrets into this file.

# Registry password: a GitHub token for ghcr.io (uses your local gh login).
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

# Rails master key, read from the untracked config/master.key.
RAILS_MASTER_KEY=$(cat config/master.key)

# Riffrec capture API key, passed through from the deploy environment. Leave it
# unset in the environment to run with feedback capture disabled (the default).

# happyhappy provider credentials, passed through from the deploy environment
# (export them in the gitignored .kamal/deploy.env). See DEPLOYING.md for where
# each one comes from. An unset variable reaches the container empty, and the
# matching feature refuses requests or stays off until it is set.
EVERY_OAUTH_CLIENT_ID=$EVERY_OAUTH_CLIENT_ID
EVERY_OAUTH_CLIENT_SECRET=$EVERY_OAUTH_CLIENT_SECRET
SLACK_SIGNING_SECRET=$SLACK_SIGNING_SECRET
SLACK_BOT_TOKEN=$SLACK_BOT_TOKEN
DISCORD_BOT_TOKEN=$DISCORD_BOT_TOKEN
INTERCOM_CLIENT_SECRET=$INTERCOM_CLIENT_SECRET
INTERCOM_ACCESS_TOKEN=$INTERCOM_ACCESS_TOKEN
POSTMARK_INBOUND_USER=$POSTMARK_INBOUND_USER
POSTMARK_INBOUND_PASSWORD=$POSTMARK_INBOUND_PASSWORD
X_BEARER_TOKEN=$X_BEARER_TOKEN
TYPESAFE_API_KEY=$TYPESAFE_API_KEY
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
