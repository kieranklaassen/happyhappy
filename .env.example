# Copy to .env for local reference. Every value is OPTIONAL — unset variables
# fall back to safe defaults (LLM providers unavailable, SSR off, capture off).
# This file carries PLACEHOLDER NAMES ONLY. Never commit real keys or endpoints.

# --- ruby_llm (LLM providers; unset = that provider is unavailable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RUBY_LLM_MODEL=
RUBY_LLM_REQUEST_TIMEOUT=

# --- TypeSafe Jev classifier (unset = classification unavailable) ---
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=

# --- Slack escalations and daily digests (unset token = posts fail and keep the error) ---
# Bot token needs the chat:write scope; invite the bot to each product's support channel.
SLACK_BOT_TOKEN=
# Base URL for item links in Slack posts, e.g. https://happyhappy.example.com
PUBLIC_BASE_URL=
# IANA or Rails zone name; digest hours and digest days use it (default UTC).
APP_TIME_ZONE=

# --- Background jobs ---
JOB_CONCURRENCY=

# --- Inertia SSR (off by default) ---
INERTIA_SSR_ENABLED=
INERTIA_SSR_TIMEOUT=

# --- Riffrec feedback capture (both required to enable; unset = no-op) ---
# PLACEHOLDER NAMES ONLY. Never commit a real key or a live endpoint.
RIFFREC_PUBLIC_KEY=
RIFFREC_ENDPOINT=
