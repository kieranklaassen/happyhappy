# Copy to .env for local reference. Every value is OPTIONAL — unset variables
# fall back to safe defaults (LLM providers unavailable, SSR off, capture off).
# This file carries PLACEHOLDER NAMES ONLY. Never commit real keys or endpoints.

# --- ruby_llm (LLM providers; unset = that provider is unavailable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RUBY_LLM_MODEL=
RUBY_LLM_REQUEST_TIMEOUT=

# --- TypeSafe Jev classifier (unset = classification unavailable) ---
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=

# --- Intercom webhooks (unset = every Intercom webhook is rejected with 401) ---
# The Intercom app's client secret; signs X-Hub-Signature on each notification.
INTERCOM_CLIENT_SECRET=
# --- Slack connector (unset signing secret = every Slack event is rejected) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Background jobs ---
JOB_CONCURRENCY=

# --- Inertia SSR (off by default) ---
INERTIA_SSR_ENABLED=
INERTIA_SSR_TIMEOUT=

# --- Riffrec feedback capture (both required to enable; unset = no-op) ---
# PLACEHOLDER NAMES ONLY. Never commit a real key or a live endpoint.
RIFFREC_PUBLIC_KEY=
RIFFREC_ENDPOINT=

# --- Sign in with Every (U2; unset = sign-in reports "not configured") ---
# Register <PUBLIC_BASE_URL>/auth/every/callback as the client's redirect URI.
EVERY_OAUTH_CLIENT_ID=
EVERY_OAUTH_CLIENT_SECRET=
EVERY_OAUTH_BASE_URL=
PUBLIC_BASE_URL=
