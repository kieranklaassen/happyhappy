# Copy to .env for local reference. Every value is OPTIONAL — unset variables
# fall back to safe defaults (LLM providers unavailable, SSR off, capture off).
# This file carries PLACEHOLDER NAMES ONLY. Never commit real keys or endpoints.

# --- ruby_llm (LLM providers; unset = that provider is unavailable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RUBY_LLM_MODEL=
RUBY_LLM_REQUEST_TIMEOUT=

# --- TypeSafe Jev classifier (unset = classification unavailable) ---
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=

# --- X recent search (unset = X sources record an error and never poll) ---
# App-only bearer token from the X developer console. Also set a monthly
# spending limit there as a backstop to each source's in-app limit.
X_BEARER_TOKEN=

# --- Background jobs ---
JOB_CONCURRENCY=

# --- Inertia SSR (off by default) ---
INERTIA_SSR_ENABLED=
INERTIA_SSR_TIMEOUT=

# --- Riffrec feedback capture (both required to enable; unset = no-op) ---
# PLACEHOLDER NAMES ONLY. Never commit a real key or a live endpoint.
RIFFREC_PUBLIC_KEY=
RIFFREC_ENDPOINT=
