<!DOCTYPE html>
<html>
  <head>
    <%# App identity comes from config/initializers/pwa.rb (pwa module) %>
    <% pwa = Rails.application.config.x.pwa %>
    <title data-inertia><%= content_for(:title) || pwa.title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= pwa.description %>">
    <% og_image = URI.join(pwa.site_url, pwa.og_image).to_s %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= pwa.name %>">
    <meta property="og:title" content="<%= pwa.title %>">
    <meta property="og:description" content="<%= pwa.description %>">
    <meta property="og:url" content="<%= pwa.site_url %>">
    <meta property="og:image" content="<%= og_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="The happyhappy sun above a row of watercolor customers in different moods">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pwa.title %>">
    <meta name="twitter:description" content="<%= pwa.description %>">
    <meta name="twitter:image" content="<%= og_image %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= pwa.name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="<%= pwa.theme_color %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# WebMCP origin trial (webmcp module): one public, origin-bound token per host; none when unset. %>
    <% Webmcp.origin_trial_tokens.each do |token| %>
      <meta http-equiv="origin-trial" content="<%= token %>">
    <% end %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= vite_stylesheet_tag "application" %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" %>
    <%= inertia_ssr_head %>
    <%= vite_typescript_tag 'application' %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->

  </head>

  <body>
    <%= yield %>
  </body>
</html>
